{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm99-research.local/schemas/pm99-season-recipe-v1.schema.json",
  "title": "PM99 season recipe V1",
  "description": "A portable, data-only recipe for deriving a season-package draft from retained sources and bounded editorial overlays. It does not describe a PM99 game tree or a database output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "season",
    "base",
    "artifacts",
    "carrier_maps",
    "source_adapters",
    "allocation",
    "policies",
    "overlays"
  ],
  "properties": {
    "schema_version": {"const": "pm99-season-recipe-v1"},
    "recipe_id": {"$ref": "#/$defs/id"},
    "season": {"$ref": "#/$defs/season"},
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_id", "descriptor_artifact_id"],
      "properties": {
        "base_id": {"$ref": "#/$defs/id"},
        "descriptor_artifact_id": {"$ref": "#/$defs/id"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "carrier_maps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode0", "mode1"],
      "properties": {
        "mode0": {"$ref": "#/$defs/carrierMap"},
        "mode1": {"$ref": "#/$defs/carrierMap"}
      }
    },
    "source_adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["squads", "managers", "opening_lineups", "kits"],
      "properties": {
        "squads": {"$ref": "#/$defs/adapter"},
        "managers": {"$ref": "#/$defs/adapter"},
        "identity_facts": {"$ref": "#/$defs/adapter"},
        "ratings": {"$ref": "#/$defs/adapter"},
        "club_metadata": {"$ref": "#/$defs/adapter"},
        "opening_lineups": {"$ref": "#/$defs/adapter"},
        "kits": {"$ref": "#/$defs/adapter"},
        "portraits": {"$ref": "#/$defs/adapter"}
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode0", "mode1"],
      "properties": {
        "mode0": {"$ref": "#/$defs/allocation"},
        "mode1": {"$ref": "#/$defs/allocation"}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating_precedence",
        "squad_snapshot",
        "formation_policy",
        "manager_policy",
        "club_name_policy",
        "portrait_fallback",
        "secondary_fact_policy",
        "kit_fallback",
        "mode1_opening"
      ],
      "properties": {
        "rating_precedence": {
          "const": [
            "reviewed-editorial",
            "nearby-season-editorial",
            "fifa-nearest-edition",
            "deterministic-context",
            "preserve-native"
          ]
        },
        "squad_snapshot": {"const": "at-club-on-first-league-fixture-date-exclude-later-arrivals"},
        "formation_policy": {"const": "published-opening-xi-formation-else-deterministic-position-inference"},
        "manager_policy": {"const": "target-season-opening-date-source-required-no-native-fallback"},
        "club_name_policy": {"const": "preserve-native-name-for-continuing-club-reassign-only-exited-carrier"},
        "portrait_fallback": {"const": "native-no-photo"},
        "secondary_fact_policy": {"const": "source-where-available-else-explicit-field-fallback"},
        "kit_fallback": {"const": "preserve-native-only-for-exited-carrier"},
        "mode1_opening": {"const": "preserve-native-only-for-exited-carrier"}
      }
    },
    "overlays": {
      "type": "array",
      "items": {"$ref": "#/$defs/overlay"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safePath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_year", "end_year", "label"],
      "properties": {
        "start_year": {"type": "integer", "minimum": 1900, "maximum": 2025},
        "end_year": {"type": "integer", "minimum": 1901, "maximum": 2026},
        "label": {"type": "string", "pattern": "^(?:19[0-9]{2}|20(?:0[0-9]|1[0-9]|2[0-5]))/[0-9]{2}$"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "relative_path", "sha256", "encoding"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {
          "type": "string",
          "enum": [
            "base-descriptor",
            "mode0-carrier-map",
            "mode1-carrier-map",
            "squad-capture",
            "identity-facts",
            "rating-snapshot",
            "club-metadata",
            "opening-lineups",
            "manager-catalogue",
            "kit-catalogue",
            "portrait-catalogue",
            "editorial-overlay",
            "other"
          ]
        },
        "relative_path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "encoding": {"enum": ["canonical-json", "opaque"]}
      }
    },
    "carrierMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "topology_policy"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "topology_policy": {"const": "existing-carriers-only"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "artifact_ids"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/id"},
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_policy", "overflow_policy"],
      "properties": {
        "selection_policy": {
          "enum": [
            "exact-normalised-name-then-editorial-overlay",
            "candidate-only-name-match"
          ]
        },
        "overflow_policy": {
          "enum": ["fail", "source-prefix-preserve-native-tail"]
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "artifact_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "stage": {
          "enum": [
            "carrier-allocation",
            "identity-resolution",
            "facts",
            "ratings",
            "club-metadata",
            "opening-lineups",
            "kits",
            "portraits"
          ]
        },
        "artifact_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
