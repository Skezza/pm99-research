{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm99-research.local/schemas/pm99-editorial-timeline-v1.schema.json",
  "title": "PM99 Editorial Timeline V1",
  "description": "Shared, source-only identities and time-scoped corrections for historical PM99 seasons.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timeline_id", "identities", "bindings", "amendments"],
  "properties": {
    "schema_version": {"const": "pm99-editorial-timeline-v1"},
    "timeline_id": {"$ref": "#/$defs/id"},
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clubs", "people"],
      "properties": {
        "clubs": {"type": "array", "items": {"$ref": "#/$defs/club"}},
        "people": {"type": "array", "items": {"$ref": "#/$defs/person"}}
      }
    },
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "amendments": {"type": "array", "items": {"$ref": "#/$defs/amendment"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$"},
    "season": {"type": "string", "pattern": "^20(0[0-9]|1[0-9]|2[0-5])-[0-9]{2}$"},
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["grade", "artifact_id"],
      "properties": {
        "grade": {"type": "string", "enum": ["source-captured", "source-receipt", "reviewed-editorial", "static-contract", "runtime-wine", "runtime-native-windows", "legacy-migrated"]},
        "artifact_id": {"$ref": "#/$defs/id"}
      }
    },
    "club": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "aliases"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    },
    "person": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "roles", "name", "aliases"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "roles": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["player", "manager"]}, "uniqueItems": true}, "name": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["season", "entity", "package_record_id", "identity_id"],
      "properties": {"season": {"$ref": "#/$defs/season"}, "entity": {"type": "string", "enum": ["player", "club", "manager"]}, "package_record_id": {"$ref": "#/$defs/id"}, "identity_id": {"$ref": "#/$defs/id"}}
    },
    "amendment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "seasons", "target", "changes", "reason", "proof"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "seasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/season"}, "uniqueItems": true},
        "target": {"type": "object", "additionalProperties": false, "required": ["entity", "identity_id"], "properties": {"entity": {"type": "string", "enum": ["player", "club", "manager"]}, "identity_id": {"$ref": "#/$defs/id"}}},
        "changes": {"type": "object", "minProperties": 1},
        "reason": {"type": "string", "minLength": 1},
        "proof": {"$ref": "#/$defs/proof"},
        "rating_provenance": {"type": "object"}
      }
    }
  }
}
