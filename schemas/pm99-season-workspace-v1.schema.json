{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm99-research.local/schemas/pm99-season-workspace-v1.schema.json",
  "title": "PM99 season workspace V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "season", "base", "package", "editorial", "ratings", "portraits"],
  "properties": {
    "schema_version": {"const": "pm99-season-workspace-v1"},
    "workspace_id": {"$ref": "#/$defs/id"},
    "season": {"type": "string", "pattern": "^(?:1999|20(?:0[0-9]|1[0-9]|2[0-5]))-[0-9]{2}$"},
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "descriptor"],
      "properties": {
        "role": {"enum": ["clean-original", "season-layer-output"]},
        "descriptor": {"$ref": "#/$defs/file"}
      }
    },
    "package": {"$ref": "#/$defs/file"},
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline", "derived_package_id", "override_id"],
      "properties": {
        "timeline": {"$ref": "#/$defs/file"},
        "derived_package_id": {"$ref": "#/$defs/id"},
        "override_id": {"$ref": "#/$defs/id"}
      }
    },
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precedence"],
      "properties": {
        "precedence": {
          "const": ["reviewed-editorial", "nearby-season-editorial", "fifa-nearest-edition", "deterministic-context", "preserve-native"]
        }
      }
    },
    "portraits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_policy", "record_missing"],
      "properties": {
        "failure_policy": {"const": "native-no-photo"},
        "record_missing": {"const": true},
        "results": {"$ref": "#/$defs/file"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
